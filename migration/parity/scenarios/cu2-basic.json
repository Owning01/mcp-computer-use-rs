{
  "name": "cu2-basic",
  "a": {
    "name": "origin",
    "cmd": ["node", "G:/Proyectos/MCP/computer-use2/src/index.js"],
    "cwd": "G:/Proyectos/MCP/computer-use2",
    "env": { "COMPUTER_USE_PROFILE": "full" }
  },
  "b": {
    "name": "target",
    "cmd": ["node", "G:/Proyectos/MCP/computer-use2/src/index.js"],
    "cwd": "G:/Proyectos/MCP/computer-use2",
    "env": { "COMPUTER_USE_PROFILE": "full" }
  },
  "steps": [
    {
      "id": "init",
      "method": "initialize",
      "params": { "protocolVersion": "2024-11-05", "capabilities": {}, "clientInfo": { "name": "judge", "version": "1.0" } },
      "compare": "drop",
      "ignoreKeys": ["serverInfo", "instructions"],
      "timeoutMs": 60000
    },
    { "id": "tools", "method": "tools/list", "compare": "volatile", "timeoutMs": 60000 },
    {
      "id": "lock",
      "tool": "computer_lock",
      "arguments": { "action": "status" },
      "compare": "drop",
      "ignoreKeys": ["dir", "pid", "agent", "id", "label", "startedAt", "refreshedAt", "expireAt", "expiresAt", "ttl", "ttl_ms", "age_ms", "expires_in_ms"],
      "timeoutMs": 30000
    },
    {
      "id": "shot",
      "tool": "computer_screenshot",
      "arguments": { "x": 0, "y": 0, "w": 400, "h": 300, "width": 200, "format": "jpeg" },
      "compare": "drop",
      "ignoreKeys": ["etag", "epoch"],
      "timeoutMs": 60000
    },
    {
      "id": "zoom",
      "tool": "computer_zoom",
      "arguments": { "x": 0, "y": 0, "w": 80, "h": 60, "scale": 2 },
      "compare": "drop",
      "ignoreKeys": ["etag", "epoch"],
      "timeoutMs": 60000
    },
    {
      "id": "screen",
      "tool": "computer_screen_info",
      "arguments": {},
      "compare": "drop",
      "ignoreKeys": ["cursor"],
      "timeoutMs": 30000
    },
    {
      "id": "awin",
      "tool": "computer_active_window",
      "arguments": {},
      "compare": "drop",
      "timeoutMs": 30000
    },
    {
      "id": "clipset",
      "tool": "computer_clipboard",
      "arguments": { "action": "set", "text": "__cu_probe__" },
      "compare": "drop",
      "ignoreKeys": ["epoch"],
      "timeoutMs": 30000
    },
    {
      "id": "clipget",
      "tool": "computer_clipboard",
      "arguments": { "action": "get" },
      "compare": "drop",
      "timeoutMs": 30000
    }
  ]
}
